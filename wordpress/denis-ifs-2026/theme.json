				{
					"slug": "frame",
					"name": "Burgundy",
					"color": "#7b2b18"
				},
				{
					"slug": "cream",
					"name": "Cream",
					"color": "#f7f0e4"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#fbf7ef"
				},
				{
					"slug": "tomato",
					"name": "Tomato",
					"color": "#e8532f"
				},
				{
					"slug": "butter",
					"name": "Butter",
					"color": "#f4e08a"
				},
				{
					"slug": "sky",
					"name": "Sky",
					"color": "#b9d2ee"
				},
				{
					"slug": "lime",
					"name": "Shirt green",
					"color": "#9cc45c"
				},
				{
					"slug": "teal",
					"name": "Shirt teal",
					"color": "#5f8f78"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#2b1a12"
				},
				{
					"slug": "muted",
					"name": "Muted brown",
					"color": "#5f4a3f"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.88rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.6rem",
					"fluid": {
						"min": "1.35rem",
						"max": "1.6rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.6rem",
					"fluid": {
						"min": "1.8rem",
						"max": "2.6rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "4rem",
					"fluid": {
						"min": "2.6rem",
						"max": "4rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "logo",
					"name": "Fraunces (logo)",
